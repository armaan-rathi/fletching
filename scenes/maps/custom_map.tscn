[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/custom_map.gd" id="1_map"]
[ext_resource type="Script" path="res://scripts/round_controller.gd" id="2_rc"]
[ext_resource type="Script" path="res://scripts/match_hud.gd" id="3_hud"]
[ext_resource type="Script" path="res://scripts/debug_hud.gd" id="4_dbg"]
