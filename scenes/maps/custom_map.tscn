[node name="MatchHud" type="CanvasLayer" parent="."]
script = ExtResource("3_hud")

[node name="DebugHud" type="CanvasLayer" parent="."]
script = ExtResource("4_dbg")

[node name="PowerUpSpawner" type="Node" parent="."]
script = ExtResource("5_pu")
