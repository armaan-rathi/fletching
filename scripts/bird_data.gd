@tool
class_name BirdData
extends Resource
## One bird of the flock: which parts it uses on the shared rig, its body shape, and its color variants.
## Purely cosmetic: every bird shares the same skeleton, hitbox and stats (design doc).
## Files live in res://data/birds/<id>.tres (generated by tools/build_bird_data.gd).

const SHARED_PARTS := ["bird_body", "wings_basic", "legs_basic", "feet_big"]
const SLOTS := ["body", "belly", "beak", "legs", "accent"]

@export var id := ""
@export var display_name := ""
@export_multiline var blurb := ""

@export_group("Parts")
## Mesh names in bird_base.glb in addition to SHARED_PARTS (head, beak halves, eyes, extras, tail).
@export var parts: PackedStringArray = []
## The head mesh; it and bird_body carry the occlusion x-ray pass.
@export var head_part := ""

@export_group("Shape")
## Body shape keys (doc): puff, hunch, slim, round -> 0..1.
@export var body_shape: Dictionary = {}
## Head size multiplier (the doc allows ±5% around the 50% head).
@export_range(0.9, 1.1) var head_scale := 1.0
## Raises the head on the neck (m) for long-necked birds; the neck_stretch part fills the gap.
@export var neck_extend := 0.0
## Leans the neck forward (degrees), e.g. the vulture's hunch.
@export var neck_pitch := 0.0

@export_group("Look")
## Rim light color (white = neutral; blue gives the crow its gloss).
@export var rim_tint := Color.WHITE
@export var rim_strength := 0.4
## Material slot whose color the eyelids use.
@export var lid_slot := "body"
## Resting eye frame (0 = the procedural resting eye below; other frames come from the shared atlas).
@export var resting_eye_frame := 0
## Resting-eye personality (eye.gdshader frame 0): lid_top, lid_slant, lid_bottom, pupil_scale,
## brow_thickness, brow_slant, brow_height, brow_raise_left, lashes. Missing keys use the shader defaults.
@export var eye_style: Dictionary = {}

@export_group("Behavior")
## Idle animation clip (the flamingo stands on one leg).
@export var idle_anim := "idle"
## Seconds without input before the bird dozes off (the owl sooner).
@export var sleepy_delay := 6.0
## How this bird celebrates winning a match (Bird.celebrate): proud, crowing, evil_laugh, who_me, smirk, giggle.
@export var victory_style := "proud"
## Up to 4 variants. Each: {"name", "body", "belly", "beak", "legs", "accent", "iris", "iris_low"}.
@export var variants: Array[Dictionary] = []

func all_parts() -> PackedStringArray:
	var p := PackedStringArray(SHARED_PARTS)
	p.append_array(parts)
	return p

func variant(i: int) -> Dictionary:
	return variants[clampi(i, 0, variants.size() - 1)] if variants.size() > 0 else {}

static func load_all() -> Array[BirdData]:
	var out: Array[BirdData] = []
	for id in ["eagle", "flamingo", "owl", "crow", "pigeon", "rooster", "swan", "vulture"]:
		var d: BirdData = load("res://data/birds/%s.tres" % id)
		if d:
			out.append(d)
	return out
