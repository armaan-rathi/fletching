[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="birds"
3d_physics/layer_3="bird_hitboxes"
3d_physics/layer_4="arrows"
3d_physics/layer_5="pickups"
3d_physics/layer_6="arrow_stickable"
3d_physics/layer_7="breakables"
3d_physics/layer_8="bird_blockers"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.18431373, 0.3647059, 0.22745098, 1)

